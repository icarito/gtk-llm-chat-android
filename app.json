{
  "expo": {
    "name": "gtk-llm-chat-android",
    "slug": "gtk-llm-chat-android",
    "version": "0.3.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "gtk-llm-chat",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "org.fuentelibre.exit-x-chat",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Permite usar el micrófono para grabar notas de voz.",
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/monochrome-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "org.fuentelibre.gtk_llm_chat",
      "versionCode": 3,
      "permissions": [
        "ACCESS_NETWORK_STATE",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "VIBRATE",
        "REQUEST_INSTALL_PACKAGES"
      ],
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "gtk-llm-chat-android",
      "shortName": "gtk-llm-chat",
      "description": "Mobile companion for gtk-llm-chat",
      "themeColor": "#0A0E14",
      "backgroundColor": "#0A0E14",
      "display": "standalone",
      "orientation": "any"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-asset",
      "expo-quick-actions",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Permite usar la cámara para enviar fotos y elegir tu foto de perfil.",
          "photosPermission": "Permite acceder a tus fotos para enviarlas y elegir tu foto de perfil.",
          "microphonePermission": "Permite usar el micrófono para grabar notas de voz."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Permite usar el micrófono para grabar notas de voz.",
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "backgroundColor": "#0A0E14",
          "resizeMode": "contain"
        }
      ],
      "expo-system-ui",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 29
          }
        }
      ],
      "./plugins/withNetworkSecurityConfig"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "newArchEnabled": true
  }
}
